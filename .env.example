# LLM Provider: "ollama" (free, local) or "groq" (free tier, cloud)
LLM_PROVIDER=groq

# Ollama settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Groq settings (get free key at console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# App
APP_HOST=0.0.0.0
APP_PORT=8000
STREAMLIT_PORT=8501

# Memory
CHROMA_PERSIST_DIR=./data/chromadb